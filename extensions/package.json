{
  "name": "pi-local-capabilities",
  "version": "1.0.0",
  "private": true,
  "description": "Optional Pi capabilities and frontend adapters, installed without replacing user configuration.",
  "license": "ISC",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:package": "node --experimental-transform-types --test package.test.ts",
    "typecheck": "tsc --noEmit",
    "sync:portable": "node scripts/sync-portable.mjs"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./ask-question/index.ts",
      "./autoname/index.ts",
      "./codex-fast/index.ts",
      "./filter-output/index.ts",
      "./sol-pi/index.ts",
      "./telegram/index.ts",
      "./worker/index.ts",
      "./pi-ui/index.ts"
    ],
    "skills": [
      "./worker/SKILL.md"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.5.0",
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "node-telegram-bot-api": "^1.2.0",
    "typebox": "^1.1.38"
  }
}
